# Terraform State Files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform Lock File
.terraform.lock.hcl

# Terraform Directories
.terraform/
.terraform.tfstate.lock.info

# Crash log files
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

